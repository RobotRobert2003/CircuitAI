		// Actual number of defences per cluster bounded by income - the order of defenses that should be build with numbers as above.
		// 23: a second Beamer / Twin Guard / Dragon's Jaw, right after the T2 flak (11) and the HLT (4).
		//     Its own slot, so Legion can get Dragon's Jaw where Armada/Cortex keep the Beamer / Twin Guard.
		//     Legion builds Dragon's Jaw in every slot-23 entry instead of a Hive; only the 5th entry is
		//     slot 3, so a full point holds one Hive (owner, 2026-10-17), right after the Juno and before
		//     the next Dragon's Jaw (owner, 2026-10-28). Slots 3 and 23 are the same Beamer / Twin Guard
		//     for Armada/Cortex, so which entry is which only moves Legion's Hive.
		// 27: Beamer / Twin Guard for the "base" defence only. Legion's list has no slot 27, so the
		//     native loader skips it: Legion no longer builds a Hive 7 min after its first factory,
		//     Armada/Cortex keep their Beamer / Twin Guard there (owner, 2026-10-17).
		// 28: Dragon's Claw / Dragon's Maw (armclaw / cormaw), right after the 2nd, 3rd and 4th Beamer /
		//     Twin Guard, so a full point holds 3 pop-ups to 4 light guns (owner, 2026-10-28). Legion's list
		//     has no slot 28, so the native loader skips it: Legion already builds Dragon's Jaw in the
		//     three slot-23 entries, one more Jaw than Hives.
		// Juno (5) is the 4th entry, after the Sentry, the light AA and one Beamer.
		// 24: long-range radar (armarad / corarad / legarad: 400 metal, 14000 energy, T2, radar 3500), once,
		//     right after the first T2 entries (12, 11): a cluster gets there only with T2 constructors about.
		// 26: Pit Bull / Scorpion / Chimera (armpb / corvipe / legapopupdef), right before the second
		//     Beamer / Twin Guard / Dragon's Jaw (23) (owner, 2026-10-16).
		// 25: long-range jammer (armveil / corshroud / legajam: 125-130 metal but 19000-20000 energy and
		//     125 E/s upkeep), once, after the first Annihilator / Doomsday / Bastion (13): late, hiding
		//     the cluster's heavy guns from enemy radar (owner, 2026-10-11: both back in the chain).
		"land":  [0, 2, 23, 5, 3, 28, 4, 23, 28, 7, 12, 11, 24, 26, 23, 28, 12, 15, 13, 25, 18, 17, 18, 20, 22, 20, 19, 19, 20, 20, 18, 17, 17, 22, 12, 12, 21, 12, 12, 12],
		"water": [1, 1, 19, 1, 4, 9, 10, 9, 10],
		"prevent": 1,  // number of preventive defences
		"amount": {  // income bound factor
			"offset": [-2.0, 2.0],
			// Amount factor: 10x10 ~ 48.0, 20x20 ~ 32.0
			"factor": [48.0, 32.0],
			"map": [10, 20]
		},
		"point_range": 600.0,  // maximum distance between 2 points in hierarchical cluster within economy cluster
	
