{
  "stop_minute": 8,
  "expect": [
    {
      "key": "spectator-commander-removed",
      "pattern": "SeaArena.*fixture_removed team=2 unit=armcom count=1",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "factory-coast-rejections",
      "pattern": "SeaArena.*factory_coast accepted=[1-9][0-9]* rejected=[1-9][0-9]* narrowed=[1-9]",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "scouts",
      "pattern": "SeaArena.*spawn.*unit=armpt",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "survey",
      "pattern": "\\[SEA\\]\\[Control\\].*surveyed=[1-9]",
      "scope": "any",
      "by_minute": 3
    },
    {
      "key": "perimeter",
      "pattern": "\\[SEA\\]\\[SubPerimeter\\]",
      "scope": "any",
      "by_minute": 5
    },
    {
      "key": "factory-coast",
      "pattern": "\\[SEA\\]\\[FactoryShore\\] supported=[1-9]",
      "scope": "any",
      "by_minute": 1
    }
  ],
  "forbid": [
    {"key": "quiet-fixture-contact", "pattern": "\\[SEA\\]\\[GuardReleased\\]", "scope": "any"},
    {
      "key": "runtime",
      "pattern": "INVARIANT|SCRIPT CRASH|: ERR\\s+:|has crashed|Lib exception|SeaArena.*ERROR",
      "scope": "any"
    }
  ]
}
