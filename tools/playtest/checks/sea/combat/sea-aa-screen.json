{
  "stop_minute": 6,
  "expect": [
    {
      "key": "loaded",
      "pattern": "\\[SeaArena\\].* loaded",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "spawn",
      "pattern": "\\[SeaArena\\].* spawn",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "orders",
      "pattern": "\\[SeaArena\\].* orders",
      "scope": "any",
      "by_minute": 2
    },
    {
      "key": "physical_patrol",
      "pattern": "\\[SeaArena\\].* boat .*patrol=true",
      "scope": "any",
      "by_minute": 2
    },
    {
      "key": "physical_air_damage",
      "pattern": "\\[SeaArena\\].*damage .*team=0 .*victimUnit=arm(brawl|thund)",
      "scope": "any",
      "by_minute": 4
    },
    {
      "key": "screen",
      "pattern": "\\[SEA\\]\\[AAFormation\\]",
      "scope": "any",
      "by_minute": 4
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "INVARIANT",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[SeaArena\\].*ERROR|Error in.*sea_arena|Removed widget: SEA combat arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    }
  ]
}
