{
  "stop_minute":4,
  "expect":[
    {"key":"loaded","pattern":"\\[SeaArena\\].* loaded", "scope":"any","by_minute":1},
    {"key":"assembled","pattern":"\\[SEA\\]\\[ScoutRaid\\].*attacking=true", "scope":"any","by_minute":2},
    {"key":"kill","pattern":"\\[SeaArena\\].*death.*attackerTeam=0 unit=corsy", "scope":"any","by_minute":3}
  ],
  "forbid":[
    {"key":"script","pattern":": ERR\\s+:|SCRIPT CRASH|Lib exception","scope":"any"},
    {"key":"invariant","pattern":"INVARIANT","scope":"any"},
    {"key":"fixture","pattern":"\\[SeaArena\\].*ERROR|Error in.*sea_arena","scope":"any"},
    {"key":"crash","pattern":"Access violation|has crashed|Fatal:","scope":"any"}
  ]
}
