{
  "stop_minute": 4,
  "expect": [
    {
      "key": "loaded",
      "pattern": "\\[SeaArena\\].* loaded",
      "scope": "any",
      "by_minute": 1
    },
    {
      "scope": "any",
      "by_minute": 2,
      "pattern": "\\[SEA\\]\\[ScoutEvade\\]",
      "key": "escape"
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "INVARIANT",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[SeaArena\\].*ERROR|Error in.*sea_arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    }
  ]
}
