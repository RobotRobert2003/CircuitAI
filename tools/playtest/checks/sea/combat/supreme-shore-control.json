    },
    {
      "key": "survey",
      "pattern": "\\[SEA\\]\\[Control\\].*surveyed=[1-9]",
      "scope": "any",
      "by_minute": 3
    },
    {
      "key": "perimeter",
      "pattern": "\\[SEA\\]\\[SubPerimeter\\]",
      "scope": "any",
      "by_minute": 5
