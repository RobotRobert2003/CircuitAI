      "pattern": "\\[Theatres\\] body .* POND .*yard=true",
      "scope": "any"
    },
    {
      "key": "overlay error",
      "pattern": "\\[TheatresUI\\] message error|Error in.*BARb theatres|\\[TheatresCheck\\] FAIL",
      "scope": "any"
