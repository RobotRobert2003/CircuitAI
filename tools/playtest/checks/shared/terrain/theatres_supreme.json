      "by_minute": 4,
      "scope": "any"
    },
    {
      "key": "pond opportunities",
      "pattern": "\\[TheatresCheck\\] PASS pond opportunities",
      "by_minute": 4,
      "scope": "any"
    },
    {
      "key": "strategic sites",
      "pattern": "\\[TheatresCheck\\] PASS strategic sites",
      "by_minute": 4,
      "scope": "any"
    },
    {
      "key": "switch player",
      "pattern": "\\[TheatresCheck\\] PASS switch player",
      "by_minute": 4,
      "scope": "any"
    },
    {
      "key": "selected team",
      "pattern": "\\[TheatresCheck\\] PASS selected team",
      "by_minute": 4,
      "scope": "any"
    },
    {
      "key": "hide all",
      "pattern": "\\[TheatresCheck\\] PASS hide all",
      "by_minute": 4,
      "scope": "any"
    },
    {
      "key": "visibility persists",
      "pattern": "\\[TheatresCheck\\] PASS visibility persists",
      "by_minute": 4,
      "scope": "any"
