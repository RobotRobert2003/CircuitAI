{
  "_doc": "D-323 battlefield blueprint: one FIELD_PERF from the owning AI, the team-link field view loads the file, the watcher takes the screenshot series. Stage gui_barb_team_link.lua plus field_watch.lua, pass --shots \"\" and --mode visual.",
  "stop_minute": 3,
  "expect": [
    {
      "key": "field analysed",
      "pattern": "FIELD_PERF",
      "by_minute": 1.5,
      "scope": "any"
    },
    {
      "key": "field loaded",
      "pattern": "\\[FieldCheck\\] PASS loaded",
      "by_minute": 2.5,
      "scope": "any"
    },
    {
      "key": "full map screenshot",
      "pattern": "\\[Playtest\\] screenshot field full",
      "by_minute": 3,
      "scope": "any"
    },
    {
      "key": "screenshot series",
      "pattern": "\\[FieldCheck\\] PASS screenshots",
      "by_minute": 3,
      "scope": "any"
    }
  ],
  "forbid": [
    {
      "key": "script error",
      "pattern": ": ERR\\s+:",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\]",
      "scope": "any"
    },
    {
      "key": "field failure",
      "pattern": "FIELD: worker failed|FIELD: check failed|\\[FieldCheck\\] FAIL",
      "scope": "any"
    },
    {
      "key": "widget error",
      "pattern": "Error in.*BARb team link|Failed to load.*gui_barb_team_link|\\[BARb link\\] message error",
      "scope": "any"
    }
  ]
}
