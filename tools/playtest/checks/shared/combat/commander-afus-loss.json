{
  "stop_minute": 1,
  "expect": [
    {
      "key": "loaded",
      "pattern": "\\[RangedArena\\].* loaded",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "plan",
      "pattern": "\\[CommanderBase\\] unit=(?P<unit>\\d+).*tier=2 action=plan",
      "scope": "any",
      "by_minute": 0.43
    },
    {
      "key": "death",
      "pattern": "\\[RangedArena\\].*death id=\\d+ team=1 unit=corafus",
      "scope": "any",
      "by_minute": 0.45
    },
    {
      "key": "release",
      "pattern": "\\[CommanderT3\\] unit=(?P<unit>\\d+).*action=done reason=afus_scope",
      "scope": "any",
      "by_minute": 0.46,
      "after_key": "death",
      "same_as": "plan"
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\]",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    },
    {
      "key": "retained",
      "pattern": "\\[CommanderBase\\]",
      "scope": "any",
      "after_minute": 0.45
    }
  ],
  "complete_on": {
    "key": "complete",
    "pattern": "\\[RangedArena\\].* scenario_complete",
    "scope": "any"
  },
  "completion_grace_seconds": 10
}
