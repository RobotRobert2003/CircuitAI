{
  "stop_minute": 2,
  "expect": [
    {
      "key": "loaded",
      "pattern": "\\[RangedArena\\].* loaded",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "funding",
      "pattern": "\\[CommanderT3\\] unit=(?P<unit>\\d+) target=(?P<target>\\d+) action=done reason=funding",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "request",
      "pattern": "\\[CommanderEnergy\\] request=",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "transfer",
      "pattern": "\\[CommanderEnergy\\] sent=",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "shot",
      "pattern": "\\[CommanderT3\\] unit=(?P<unit>\\d+) target=(?P<target>\\d+) action=fire",
      "scope": "any",
      "by_minute": 2,
      "same_as": "funding",
      "after_key": "funding"
    },
    {
      "key": "kill",
      "pattern": "\\[RangedArena\\].*death id=\\d+ team=2 unit=armmar",
      "scope": "any",
      "by_minute": 2
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\]",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    }
  ],
  "complete_on": {
    "key": "complete",
    "pattern": "\\[RangedArena\\].* scenario_complete",
    "scope": "any"
  },
  "completion_grace_seconds": 10
}
