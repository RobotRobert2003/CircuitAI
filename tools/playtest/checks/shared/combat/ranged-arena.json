{
  "stop_minute": 4,
  "expect": [
    {
      "key": "loaded",
      "pattern": "\\[RangedArena\\].* loaded",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "spawn",
      "pattern": "\\[RangedArena\\].* spawn",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "damage",
      "pattern": "\\[RangedArena\\].* damage.*attackerTeam=0",
      "scope": "any",
      "by_minute": 3
    },
    {
      "key": "orders",
      "pattern": "\\[RangedArena\\].* orders team=0",
      "scope": "any",
      "by_minute": 2
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "INVARIANT",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena|Removed widget: Ranged combat arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    },
    {
      "key": "policy",
      "pattern": "has invalid ranged policy",
      "scope": "any"
    }
  ]
}
