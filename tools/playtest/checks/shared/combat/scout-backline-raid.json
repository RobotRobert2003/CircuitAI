{
  "stop_minute": 11,
  "_doc": "D-296 scout backline raid. Pass: raiders admitted and routed by minute 2, first economy kill by minute 8 and three by minute 10 (detours around the front, holds on contact and the engine walk to z~9000 cost time; round 12 raiders reached the mex field at 4-5 min), at most two scouts killed by static defences, no front unit killed by a scout (incidental fire is allowed, a chosen armed target is not), no INVARIANT (INV-211/212/213). Run with --minutes 11.",
  "expect": [
    {
      "key": "loaded",
      "pattern": "\\[RangedArena\\].* loaded",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "spawn",
      "pattern": "\\[RangedArena\\].* spawn",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "admitted",
      "pattern": "\\[ScoutRaid\\] admit unit=",
      "scope": "any",
      "by_minute": 2
    },
    {
      "key": "routed",
      "pattern": "\\[ScoutRaid\\] route unit=\\d+ target=",
      "scope": "any",
      "by_minute": 2
    },
    {
      "key": "depth",
      "pattern": "\\[RangedArena\\].* scout_depth max_z=",
      "scope": "any",
      "by_minute": 2
    },
    {
      "key": "first economy kill",
      "pattern": "\\[RangedArena\\].* killed def=(cormex|corwin|cornanotc|armmex|armwin|armnanotc) team=1 by=(armflea|corfav|legscout)",
      "scope": "any",
      "by_minute": 8
    },
    {
      "key": "three economy kills",
      "pattern": "\\[RangedArena\\].* kill_census econ=([3-9]|\\d\\d+)",
      "scope": "any",
      "by_minute": 10
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "INVARIANT",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena|Removed widget: Ranged combat arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    },
    {
      "key": "policy",
      "pattern": "has invalid ranged policy",
      "scope": "any"
    },
    {
      "key": "raider lost to statics",
      "pattern": "\\[RangedArena\\].* kill_census .*static_losses=([3-9]|\\d\\d+)",
      "scope": "any"
    },
    {
      "key": "raider fought the front",
      "pattern": "\\[RangedArena\\].* killed def=(corthud|armham) team=1 by=(armflea|corfav|legscout)",
      "scope": "any"
    }
  ]
}
