{
  "stop_minute": 2,
  "expect": [
    {
      "key": "loaded",
      "pattern": "\\[RangedArena\\].* loaded",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "policy",
      "pattern": "\\[Commander\\] policy role=",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "shot",
      "pattern": "\\[Commander\\].*shot_confirmed",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "damage",
      "pattern": "\\[RangedArena\\].* damage.*attackerTeam=0.*weaponName=.*(dgun|disintegrator)",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "operation",
      "pattern": "lifecycle_operation_preserved",
      "scope": "any",
      "by_minute": 0.5
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\]",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    }
  ],
  "complete_on": {
    "key": "complete",
    "pattern": "\\[RangedArena\\].* scenario_complete",
    "scope": "any"
  },
  "completion_grace_seconds": 10
}
