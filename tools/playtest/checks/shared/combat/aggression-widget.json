{
  "stop_minute": 4,
  "expect": [
    {
      "key": "ui-complete",
      "pattern": "\\[AggressionTest\\] complete",
      "scope": "any",
      "by_minute": 1
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "INVARIANT",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena|Removed widget: Ranged combat arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    },
    {
      "key": "policy",
      "pattern": "has invalid ranged policy",
      "scope": "any"
    },
    {
      "key": "ui-error",
      "pattern": "\\[AggressionTest\\] ERROR",
      "scope": "any"
    }
  ]
}
