{
  "stop_minute": 2,
  "expect": [
    {
      "key": "first sea band",
      "pattern": "\\[CoverageLane\\] team=0 class=5 share=0\\.2500 seats=2 points=[1-9][0-9]+",
      "scope": "any",
      "by_minute": 2
    },
    {
      "key": "second sea band",
      "pattern": "\\[CoverageLane\\] team=0 class=5 share=0\\.7500 seats=2 points=[1-9][0-9]+",
      "scope": "any",
      "by_minute": 2
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\]",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena",
      "scope": "any"
    }
  ]
}
