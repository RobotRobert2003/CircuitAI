{
  "stop_minute": 2,
  "expect": [
    {
      "key": "loaded",
      "pattern": "\\[RangedArena\\].* loaded",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "policy",
      "pattern": "\\[Commander\\] policy role=",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "fallback",
      "pattern": "\\[CommanderFallback\\] unit=\\d+ on metal=",
      "scope": "any",
      "by_minute": 1.2
    },
    {
      "key": "porc_line",
      "pattern": "\\[CommanderFallback\\] unit=\\d+ line porc=\\d+",
      "scope": "any",
      "by_minute": 1.2
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\]",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    }
  ]
}
