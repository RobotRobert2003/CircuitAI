{
  "stop_minute": 3,
  "expect": [
    {
      "key": "ready",
      "pattern": "\\[CommanderFront\\] ready=1",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "deploy",
      "pattern": "\\[CommanderFront\\].*deploy",
      "scope": "any",
      "by_minute": 1.5
    },
    {
      "key": "work",
      "pattern": "\\[Commander(Front|Work)\\].*work=(0|2|3|9|10) ",
      "scope": "any",
      "by_minute": 2.5
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\]",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    }
  ]
}
