{
  "stop_minute":10,
  "expect":[
    {"key":"loaded","pattern":"\\[AirArena\\] event=loaded","scope":"any","by_minute":1},
    {"key":"contact","pattern":"\\[AIR\\]\\[BaseResponse\\] contact=true","scope":"tech","by_minute":2},
    {"key":"funded-bomber-production","pattern":"\\[AIR\\]\\[Produce\\] wave.bomber armpnix .*baseContact=true","scope":"tech","by_minute":8},
    {"key":"completed-bomber","pattern":"\\[AirArena\\] event=produced .*team=0 unit=armpnix","scope":"any","by_minute":8}
  ],
  "forbid":[
    {"key":"script","pattern":": ERR\\s+:|SCRIPT CRASH|Lib exception","scope":"any"},
    {"key":"invariant","pattern":"INVARIANT|\\[AirOrders\\] ERROR","scope":"any"},
    {"key":"fixture","pattern":"\\[AirArena\\] event=error|Removed widget: AIR combat arena|Error in.*air_arena","scope":"any"},
    {"key":"crash","pattern":"Access violation|has crashed|Fatal:","scope":"any"}
  ]
}
