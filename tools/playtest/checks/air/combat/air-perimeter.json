    {"key":"ground-defense","pattern":"\\[AIR\\]\\[BaseResponse\\] contact=true","scope":"any","by_minute":5},
    {"key":"bomber-escorts","pattern":"\\[AirPerimeterProbe\\].*team=0 .*ground=0 committed=[1-9]","scope":"any","by_minute":7},
