{
  "stop_minute": 4,
  "expect": [
    {
      "key": "population ready",
      "pattern": "fixture_ready supplied=192",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "perf samples",
      "pattern": "\\[WorkforcePerf\\] frame=7200",
      "scope": "any",
      "by_minute": 4
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\]",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena",
      "scope": "any"
    },
    {
      "key": "population loss",
      "pattern": "\\[RangedArena\\].*death id=",
      "scope": "any"
    }
  ]
}
