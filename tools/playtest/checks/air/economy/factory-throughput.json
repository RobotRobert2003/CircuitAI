    {"key":"loaded","pattern":"\\[RangedArena\\].*loaded case=air-factory-throughput","scope":"any","by_minute":1},
    {"key":"completed-product","pattern":"\\[RangedArena\\].*finished.*team=0 unit=(armhawk|corvamp|legvenator|armpnix|corhurc|legphoenix)","scope":"any","by_minute":2},
    {"key":"sampled","pattern":"\\[RangedArena\\].* throughput id=","scope":"any","by_minute":2}
  ],
  "forbid": [
    {"key":"script","pattern":": ERR\\s+:|SCRIPT CRASH|Lib exception","scope":"any"},
    {"key":"invariant","pattern":"INVARIANT","scope":"any"},
    {"key":"fixture","pattern":"\\[RangedArena\\].*ERROR|Removed widget: Ranged combat arena|Error in.*ranged_arena","scope":"any"},
    {"key":"crash","pattern":"Access violation|has crashed|Fatal:","scope":"any"}
  ]
}
