{
  "stop_minute": 1,
  "expect": [
    {
      "key": "energy recovery",
      "pattern": "\\[AIR\\]\\[Economy\\] MULTIPLANT RECOVERY",
      "scope": "any",
      "by_minute": 1
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\]",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena",
      "scope": "any"
    },
    {
      "key": "no urgent production growth in recovery",
      "pattern": "\\[AIR\\]\\[Rule\\] overflow.production.support",
      "scope": "any"
    }
  ]
}
