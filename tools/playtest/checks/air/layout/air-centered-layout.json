{
  "stop_minute": 4,
  "expect": [
    {
      "key": "support priority",
      "pattern": "\\[AIR\\]\\[Rule\\] overflow.production.support",
      "scope": "any",
      "by_minute": 2
    },
    {
      "key": "completed production support",
      "pattern": "\\[AIR\\]\\[Bay\\] \\d+ plant=\\d+ BP=\\d+ nanos=([6-9]|1\\d|20)\\+",
      "scope": "any",
      "by_minute": 4
    },
    {
      "key": "centered reserved T2 factory",
      "pattern": "\\[AirClusterProbe\\] PASS centered bay=",
      "scope": "any",
      "by_minute": 2
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\]",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena",
      "scope": "any"
    },
    {
      "key": "miscentered factory",
      "pattern": "\\[AirClusterProbe\\] FAIL centered bay=",
      "scope": "any"
    }
  ]
}
